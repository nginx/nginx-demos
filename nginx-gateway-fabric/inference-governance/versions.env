# Pinned versions. Sourced by every script and by the toolbox image build.
CLUSTER_NAME=inference-governance
KIND_NODE_IMAGE=kindest/node:v1.37.0

GATEWAY_API_VERSION=v1.6.3          # what NGF v2.8.0 pins
GIE_VERSION=v1.6.2                  # InferencePool CRD, what NGF v2.8.0 pins
NGF_VERSION=2.8.0                   # Helm chart + image tag
LLMD_ROUTER_VERSION=v0.11.0         # EPP image, InferenceObjective CRD
INFERENCE_SIM_VERSION=v1.0.0        # llm-d-inference-sim image
KYVERNO_CHART_VERSION=3.9.2         # Kyverno v1.19.2
KYVERNO_CLI_IMAGE=reg.kyverno.io/kyverno/kyverno-cli:v1.19.2   # CLI for `make test`, copied into the toolbox
POLICY_REPORTER_CHART_VERSION=3.11.2
CURL_IMAGE=curlimages/curl:8.19.0

GATEWAY_URL=http://localhost:8080   # kind port mapping -> NGINX NodePort 30080

# Toolbox (env/toolbox/Dockerfile): every tool the scripts run, on top of Docker-in-Docker. Only
# Docker, make and git are needed on the host.
DIND_IMAGE=docker:29.8.1-dind
KUBECTL_IMAGE=registry.k8s.io/kubectl:v1.37.1
YQ_IMAGE=mikefarah/yq:4.54.1
KIND_VERSION=v0.33.0
HELM_VERSION=v4.3.1
